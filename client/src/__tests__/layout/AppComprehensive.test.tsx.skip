import { describe, it, expect, vi, beforeEach } from 'vitest';
import { render, screen, waitFor, fireEvent } from '@testing-library/react';
import { BrowserRouter } from 'react-router-dom';
import { Provider } from 'react-redux';
import { configureStore } from '@reduxjs/toolkit';
import App from '../../app/layout/App';
import { accountSlice } from '../../features/account/accountSlice';
import { basketSlice } from '../../features/basket/basketSlice';

// Mock localStorage utility
const mockGetBasketFromLocalStorage = vi.fn();
vi.mock('../../app/util/util', () => ({
  getBasketFromLocalStorage: mockGetBasketFromLocalStorage
}));

// Mock API agent
const mockAgentBasketGet = vi.fn();
vi.mock('../../app/api/agent', () => ({
  default: {
    Basket: {
      get: mockAgentBasketGet
    }
  }
}));

// Mock account slice
const mockFetchCurrentUser = vi.fn();
vi.mock('../../features/account/accountSlice', () => ({
  accountSlice: {
    name: 'account',
    reducer: vi.fn((state = { user: null, status: 'idle' }) => state),
  },
  fetchCurrentUser: mockFetchCurrentUser
}));

// Mock basket slice
const mockSetBasket = vi.fn();
vi.mock('../../features/basket/basketSlice', () => ({
  basketSlice: {
    name: 'basket',
    reducer: vi.fn((state = { basket: null, status: 'idle' }) => state),
  },
  setBasket: mockSetBasket
}));

// Mock Header component
vi.mock('../../app/layout/Header', () => ({
  default: ({ darkMode, handleThemeChange }: any) => (
    <div data-testid="mock-header">
      <span data-testid="theme-mode">{darkMode ? 'dark' : 'light'}</span>
      <button data-testid="theme-toggle" onClick={handleThemeChange}>
        Toggle Theme
      </button>
    </div>
  )
}));

// Mock Spinner component
vi.mock('../../app/layout/Spinner', () => ({
  default: ({ message }: any) => (
    <div data-testid="spinner">{message}</div>
  )
}));

// Mock ToastContainer
vi.mock('react-toastify', () => ({
  ToastContainer: () => <div data-testid="toast-container" />,
  toast: {
    success: vi.fn(),
    error: vi.fn(),
    warning: vi.fn(),
    info: vi.fn()
  }
}));

// Mock Outlet
vi.mock('react-router-dom', async () => {
  const actual = await vi.importActual('react-router-dom') as any;
  return {
    ...actual,
    Outlet: () => <div data-testid="outlet">Main Content</div>
  };
});

describe('App Component - Comprehensive Tests', () => {
  let store: any;
  let consoleSpy: any;

  beforeEach(() => {
    vi.clearAllMocks();
    consoleSpy = vi.spyOn(console, 'log').mockImplementation(() => {});
    
    store = configureStore({
      reducer: {
        account: accountSlice.reducer,
        basket: basketSlice.reducer,
      },
      preloadedState: {
        account: { user: null, status: 'idle' },
        basket: { basket: null, status: 'idle' },
      },
    });

    // Reset mocks
    mockGetBasketFromLocalStorage.mockReturnValue(null);
    mockAgentBasketGet.mockResolvedValue({ id: '1', items: [] });
    mockFetchCurrentUser.mockReturnValue({ type: 'account/fetchCurrentUser/pending' });
    mockSetBasket.mockReturnValue({ type: 'basket/setBasket' });
  });

  const renderApp = () => {
    return render(
      <Provider store={store}>
        <BrowserRouter>
          <App />
        </BrowserRouter>
      </Provider>
    );
  };

  describe('Initial Rendering', () => {
    it('renders app with header and main content', async () => {
      renderApp();
      
      expect(screen.getByTestId('mock-header')).toBeInTheDocument();
      expect(screen.getByTestId('outlet')).toBeInTheDocument();
      expect(screen.getByTestId('toast-container')).toBeInTheDocument();
    });

    it('renders with light theme by default', async () => {
      renderApp();
      
      expect(screen.getByTestId('theme-mode')).toHaveTextContent('light');
    });

    it('dispatches fetchCurrentUser on mount', async () => {
      renderApp();
      
      expect(mockFetchCurrentUser).toHaveBeenCalled();
    });
  });

  describe('Theme Management', () => {
    it('toggles between light and dark theme', async () => {
      renderApp();
      
      const themeToggle = screen.getByTestId('theme-toggle');
      const themeMode = screen.getByTestId('theme-mode');
      
      expect(themeMode).toHaveTextContent('light');
      
      fireEvent.click(themeToggle);
      expect(themeMode).toHaveTextContent('dark');
      
      fireEvent.click(themeToggle);
      expect(themeMode).toHaveTextContent('light');
    });

    it('applies correct theme provider settings', async () => {
      renderApp();
      
      // Check that MUI ThemeProvider is rendered (component structure)
      const header = screen.getByTestId('mock-header');
      expect(header).toBeInTheDocument();
    });
  });

  describe('Basket Loading Logic', () => {
    it('shows spinner when loading basket', async () => {
      mockGetBasketFromLocalStorage.mockReturnValue({ id: '1', items: [] });
      mockAgentBasketGet.mockImplementation(() => new Promise(() => {})); // Never resolves
      
      renderApp();
      
      expect(screen.getByTestId('spinner')).toBeInTheDocument();
      expect(screen.getByText('Getting Basket...')).toBeInTheDocument();
    });

    it('loads basket from localStorage and API when basket exists', async () => {
      const mockBasket = { id: '1', items: [{ id: 1, quantity: 2 }] };
      mockGetBasketFromLocalStorage.mockReturnValue(mockBasket);
      mockAgentBasketGet.mockResolvedValue(mockBasket);
      
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      expect(mockAgentBasketGet).toHaveBeenCalled();
      expect(mockSetBasket).toHaveBeenCalledWith(mockBasket);
    });

    it('skips API call when no basket in localStorage', async () => {
      mockGetBasketFromLocalStorage.mockReturnValue(null);
      
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      expect(mockAgentBasketGet).not.toHaveBeenCalled();
      expect(mockSetBasket).not.toHaveBeenCalled();
    });

    it('handles basket API errors gracefully', async () => {
      const mockBasket = { id: '1', items: [] };
      mockGetBasketFromLocalStorage.mockReturnValue(mockBasket);
      mockAgentBasketGet.mockRejectedValue(new Error('Network error'));
      
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      expect(consoleSpy).toHaveBeenCalledWith(expect.any(Error));
    });
  });

  describe('Layout Structure', () => {
    it('renders with correct MUI components structure', async () => {
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      // Verify main structure elements are present
      expect(screen.getByTestId('mock-header')).toBeInTheDocument();
      expect(screen.getByTestId('outlet')).toBeInTheDocument();
      expect(screen.getByTestId('toast-container')).toBeInTheDocument();
    });

    it('applies correct container styling with padding', async () => {
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      // Container should be present (implicit through rendered content)
      expect(screen.getByTestId('outlet')).toBeInTheDocument();
    });
  });

  describe('Error Handling & Edge Cases', () => {
    it('handles invalid basket data from localStorage', async () => {
      mockGetBasketFromLocalStorage.mockReturnValue(undefined);
      
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      expect(mockAgentBasketGet).not.toHaveBeenCalled();
    });

    it('continues app functionality when fetchCurrentUser fails', async () => {
      mockFetchCurrentUser.mockImplementation(() => { 
        throw new Error('Auth error'); 
      });
      
      renderApp();
      
      // App should still render despite auth errors
      expect(screen.getByTestId('mock-header')).toBeInTheDocument();
    });

    it('handles null basket response from API', async () => {
      const mockBasket = { id: '1', items: [] };
      mockGetBasketFromLocalStorage.mockReturnValue(mockBasket);
      mockAgentBasketGet.mockResolvedValue(null);
      
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      expect(mockSetBasket).toHaveBeenCalledWith(null);
    });
  });

  describe('Integration Behavior', () => {
    it('properly integrates all components in loading sequence', async () => {
      const mockBasket = { id: '1', items: [{ id: 1, quantity: 1 }] };
      mockGetBasketFromLocalStorage.mockReturnValue(mockBasket);
      mockAgentBasketGet.mockResolvedValue(mockBasket);
      
      renderApp();
      
      // Should show spinner first
      expect(screen.getByTestId('spinner')).toBeInTheDocument();
      
      // Then show main content after loading
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
        expect(screen.getByTestId('outlet')).toBeInTheDocument();
      });
      
      // Verify all actions were called
      expect(mockFetchCurrentUser).toHaveBeenCalled();
      expect(mockAgentBasketGet).toHaveBeenCalled();
      expect(mockSetBasket).toHaveBeenCalledWith(mockBasket);
    });

    it('maintains state consistency across theme changes', async () => {
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      const themeToggle = screen.getByTestId('theme-toggle');
      const themeMode = screen.getByTestId('theme-mode');
      
      // Change theme multiple times
      fireEvent.click(themeToggle);
      expect(themeMode).toHaveTextContent('dark');
      
      fireEvent.click(themeToggle);
      expect(themeMode).toHaveTextContent('light');
      
      // Other components should still be rendered
      expect(screen.getByTestId('outlet')).toBeInTheDocument();
      expect(screen.getByTestId('toast-container')).toBeInTheDocument();
    });
  });

  describe('Performance & Optimization', () => {
    it('does not cause infinite re-renders', async () => {
      const renderCount = vi.fn();
      
      // Override the mock to count renders
      vi.doMock('../../app/layout/Header', () => ({
        default: (props: any) => {
          renderCount();
          return (
            <div data-testid="mock-header">
              <span data-testid="theme-mode">{props.darkMode ? 'dark' : 'light'}</span>
              <button data-testid="theme-toggle" onClick={props.handleThemeChange}>
                Toggle Theme
              </button>
            </div>
          );
        }
      }));
      
      renderApp();
      
      await waitFor(() => {
        expect(screen.queryByTestId('spinner')).not.toBeInTheDocument();
      });
      
      // Should render a reasonable number of times (not infinite)
      expect(renderCount).toHaveBeenCalledTimes(expect.any(Number));
    });
  });
});